			class leadingPlayer {};
			class suspensemusic {};
			class handleDamage {};
			class currentWeaponListEntry {};
			class parseWeaponText {};
			class disableFallDamage {postInit=1};
			class handleOutsideArea {postInit=1};
			class openPlayerSettings {};
			class savePlayerSettings {};
            class setupCBAKeys {};
